{
    "name": "internetztube/craft-element-relations",
    "description": "See where every element is used: one native list across all element types, sites and supported plugins, with Twig, GraphQL and element query support. Pro: unused filter, replace with undo.",
    "type": "craft-plugin",
    "version": "4.0.1.3",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "element-relations",
        "relations",
        "usage",
        "where used",
        "unused assets",
        "replace"
    ],
    "support": {
        "docs": "https://github.com/internetztube/craft-element-relations/blob/4.x/README.md",
        "issues": "https://github.com/internetztube/craft-element-relations/issues",
        "source": "https://github.com/internetztube/craft-element-relations"
    },
    "license": "proprietary",
    "authors": [
        {
            "name": "Frederic Koeberl",
            "homepage": "https://frederickoeberl.com/"
        }
    ],
    "require": {
        "ext-json": "*",
        "craftcms/cms": "^5.3.0"
    },
    "autoload": {
        "psr-4": {
            "internetztube\\elementRelations\\": "src/"
        }
    },
    "extra": {
        "name": "Element Relations",
        "handle": "element-relations",
        "developer": "Frederic Koeberl",
        "developerUrl": "https://frederickoeberl.com/",
        "documentationUrl": "https://github.com/internetztube/craft-element-relations/blob/4.x/README.md",
        "changelogUrl": "https://raw.githubusercontent.com/internetztube/craft-element-relations/4.x/CHANGELOG.md",
        "class": "internetztube\\elementRelations\\ElementRelations"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    },
    "require-dev": {
        "craftcms/rector": "dev-main",
        "craftcms/phpstan": "dev-main"
    }
}
