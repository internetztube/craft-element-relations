{
    "name": "internetztube/craft-element-relations",
    "description": "See where every element is used: one native list across all element types, sites and supported plugins, with Twig, GraphQL and element query support. Unused filter, replace with undo.",
    "type": "craft-plugin",
    "version": "5.0.0-alpha.1",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "element-relations",
        "relations",
        "usage",
        "where used",
        "unused assets",
        "replace"
    ],
    "support": {
        "docs": "https://github.com/internetztube/craft-element-relations/blob/5.x/README.md",
        "issues": "https://github.com/internetztube/craft-element-relations/issues",
        "source": "https://github.com/internetztube/craft-element-relations"
    },
    "license": "proprietary",
    "authors": [
        {
            "name": "Frederic Koeberl",
            "homepage": "https://frederickoeberl.com/"
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-json": "*",
        "craftcms/cms": "^6.0.0-alpha.20"
    },
    "autoload": {
        "psr-4": {
            "Internetztube\\ElementRelations\\": "src/"
        }
    },
    "extra": {
        "name": "Element Relations",
        "handle": "element-relations",
        "developer": "Frederic Koeberl",
        "developerUrl": "https://frederickoeberl.com/",
        "documentationUrl": "https://github.com/internetztube/craft-element-relations/blob/5.x/README.md",
        "changelogUrl": "https://raw.githubusercontent.com/internetztube/craft-element-relations/5.x/CHANGELOG.md",
        "class": "Internetztube\\ElementRelations\\ElementRelations"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true
        }
    }
}
