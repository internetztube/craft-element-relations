{% import '_includes/forms.twig' as forms %}

{# Settings set in config/element-relations.php win; show them read-only with a hint, like Craft does for general config. #}
{% set overrides = craft.app.config.getConfigFromFile('element-relations') %}
{% macro overrideWarning(name, overrides) %}
    {%- if name in overrides|keys -%}
        {{ 'settings-overridden'|t('element-relations', {name: name}) }}
    {%- endif -%}
{% endmacro %}

{{ forms.textField({
    first: true,
    type: 'number',
    min: 1,
    label: 'settings-batch-size-label'|t('element-relations'),
    instructions: 'settings-batch-size-instructions'|t('element-relations'),
    name: 'bulkRefreshBatchSize',
    value: settings.bulkRefreshBatchSize,
    errors: settings.getErrors('bulkRefreshBatchSize'),
    disabled: 'bulkRefreshBatchSize' in overrides|keys,
    warning: _self.overrideWarning('bulkRefreshBatchSize', overrides),
}) }}

{% if craft.app.plugins.getPlugin('element-relations').is('pro') %}
    {{ forms.textField({
        type: 'number',
        min: 0,
        label: 'settings-replace-sync-limit-label'|t('element-relations'),
        instructions: 'settings-replace-sync-limit-instructions'|t('element-relations'),
        name: 'replaceSyncLimit',
        value: settings.replaceSyncLimit,
        errors: settings.getErrors('replaceSyncLimit'),
        disabled: 'replaceSyncLimit' in overrides|keys,
        warning: _self.overrideWarning('replaceSyncLimit', overrides),
    }) }}
{% endif %}
