{% import '_includes/forms.twig' as forms %}

{# Settings set in config/element-relations.php win; show them read-only with a hint, like Craft does for general config. #}
{% set overrides = craft.app.config.getConfigFromFile('element-relations') %}
{% macro overrideWarning(name, overrides) %}
    {%- if name in overrides|keys -%}
        {{ 'settings-overridden'|t('element-relations', {name: name}) }}
    {%- endif -%}
{% endmacro %}

{{ forms.textField({
    first: true,
    type: 'number',
    min: 1,
    label: 'settings-batch-size-label'|t('element-relations'),
    instructions: 'settings-batch-size-instructions'|t('element-relations'),
    name: 'bulkRefreshBatchSize',
    value: settings.bulkRefreshBatchSize,
    errors: settings.getErrors('bulkRefreshBatchSize'),
    disabled: 'bulkRefreshBatchSize' in overrides|keys,
    warning: _self.overrideWarning('bulkRefreshBatchSize', overrides),
}) }}

{{ forms.textField({
    type: 'number',
    min: 1,
    max: 100,
    label: 'settings-parallel-jobs-label'|t('element-relations'),
    instructions: 'settings-parallel-jobs-instructions'|t('element-relations'),
    name: 'rebuildParallelJobs',
    value: settings.rebuildParallelJobs,
    errors: settings.getErrors('rebuildParallelJobs'),
    disabled: 'rebuildParallelJobs' in overrides|keys,
    warning: _self.overrideWarning('rebuildParallelJobs', overrides),
}) }}

{# behind the editions flag only: what the other edition adds, and where to get it (admins only, see ElementRelations::upsells()) #}
{% set plugin = craft.app.plugins.getPlugin('element-relations') %}
{% if plugin.upsells() %}
    <div class="pane" data-element-relations-upsell style="margin-top: var(--xl);">
        <h2 class="flex gap-xs" style="margin-top: 0;"><span class="cp-icon" aria-hidden="true" style="color: var(--gray-700);">{{ svg('@internetztube/elementRelations/icon-mask.svg') }}</span>{{ 'upsell-settings-heading'|t('element-relations') }}</h2>
        <p>{{ 'upsell-settings-intro'|t('element-relations') }}</p>
        <ul class="bullets" style="margin-bottom: var(--m);">
            {% for key in ['replace', 'undo', 'unused', 'protect', 'cli'] %}
                <li>{{ ('upsell-settings-' ~ key)|t('element-relations') }}</li>
            {% endfor %}
        </ul>
        <a class="btn submit" href="{{ plugin.upgradeUrl() }}">{{ 'upsell-link'|t('element-relations') }}</a>
    </div>
{% endif %}

{# the in-use protection (services/InUseGuard, the delete dialog) #}
{% if plugin.isPro() %}
    {{ forms.lightswitchField({
        label: 'settings-protect-label'|t('element-relations'),
        instructions: 'settings-protect-instructions'|t('element-relations'),
        name: 'protectInUse',
        on: settings.protectInUse,
        disabled: 'protectInUse' in overrides|keys,
        warning: _self.overrideWarning('protectInUse', overrides),
    }) }}
{% endif %}

