{% set isMultiSite = craft.app.sites.getAllSites() | length > 1 %}

<table class="table" style="width: 100%;">
    {% for element in elements %}
        <tr style="
            border-block: 1px solid #e5e7eb;
        ">
            <td>
                {% if element.cpEditUrl %}
                    <a href="{{ element.cpEditUrl }}" style="text-decoration:none;color:inherit;">
                {% endif %}
                {{ elementRelationsElementPreviewHtml([element], 1, "") | raw }}
                {% if element.cpEditUrl %}
                    </a>
                {% endif %}
            </td>
            <td>
                {% if element.url %}
                    <a href="{{ element.url }}" title="Visit webpage" rel="noopener" target="_blank"
                       data-icon="world" aria-label="View"></a>
                {% endif %}
            </td>
            <td title="{{ className(element) }} (elementType)">
                {{ element.displayName }}
            </td>
            {% if isMultiSite %}
                <td title="{{ element.site.handle }} (site)">
                    {{ element.site.name }}
                </td>
            {% endif %}
            {% if className(element) == 'craft\\elements\\Entry' and element.section %}
                <td title="{{ element.section.handle }} (section)">
                    {{ element.section.name }}
                </td>
            {% else %}
                <td></td>
            {% endif %}
            {% if className(element) == 'craft\\elements\\Entry' and element.type %}
                <td title="{{ element.type.handle }} (entryType)">
                    {{ element.type.name }}
                </td>
            {% else %}
                <td></td>
            {% endif %}
        </tr>
    {% endfor %}
</table>