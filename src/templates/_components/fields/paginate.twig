{% set isMultiSite = craft.app.sites.getAllSites() | length > 1 %}

<table class="table" style="width: 100%;">
    {% for element in elements %}
        <tr style="border-block: 1px solid #e5e7eb;">
            <td style="white-space: nowrap;">
                <span style="display: inline-block;">{{ elementRelationsElementPreviewHtml([element], 1, "") | raw }}</span>
                {% if className(element) == 'craft\\elements\\Entry' and element.section %}
                    <span style="color: #666; font-weight: normal; margin-left: 4px;">({{ element.section.name }})</span>
                {% endif %}
            </td>
            <td title="{{ className(element) }} (elementType)">
                {{ element.displayName }}
            </td>
            {% if isMultiSite %}
                <td title="{{ element.site.handle }} (site)">
                    {{ element.site.name }}
                </td>
            {% endif %}
            <td>
                {% if element.url %}
                    <a href="{{ element.url }}" title="Visit webpage" rel="noopener" target="_blank"
                       data-icon="world" aria-label="View"></a>
                {% endif %}
            </td>
        </tr>
    {% endfor %}
</table>
