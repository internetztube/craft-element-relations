{# Expects an Element; Returns on array of Elements. #}
{% set relations = elementRelationsGetRelations(element) %}
{# Expects an Elements; Returns a boolen. #}
{% set seomaticGlobal = elementRelationsIsUsedInSeomaticGlobalSettings(element) %}

{% if not relations and not seomaticGlobal %}
    <span style="color: red">{{ 'field-value-unused' | t('element-relations') }}</span>
{% else %}
    <table class="table">
        <thead>
            <tr>
                <th>Element</th>
                <th>Site</th>
                <th>Section</th>
                <th>Link</th>
            </tr>
        </thead>
        <tbody>
        {% if seomaticGlobal ?? null %}
            <tr>
                <td colspan="2">{{ 'field-value-seomatic-global' | t('element-relations') }}</td>
                <td></td>
                <td></td>
            </tr>
        {% endif %}

        {% for relation in relations %}
            {# Check on className to help configure other plugins #}
            {% set className = className(relation) %}

            {% switch(className) %}
                {% case "verbb\\formie\\elements\\Submission" %}
                    {% set sectionName = "Formie Submission"|t("element-relations") %}
                    {% set relationUrl = relation.getCpEditUrl() %}

                {% default %}
                    {% set sectionName = relation.section.name|default("") %}
                    {% set relationUrl = relation.url %}
            {% endswitch %}
            {% set siteName = relation.site.name %}

            <tr>
                <td style="white-space: nowrap;">
                    <span style="display: inline-block;">{{ elementRelationsElementPreviewHtml([relation]) | raw }}</span>
                </td>
                <td>{{ siteName }}</td>
                <td>
                    <span style="color: #666; font-weight: normal; margin-left: 4px;">{{ sectionName ?? "-" }}</span>
                </td>
                <td>
                    {% if relationUrl %}
                        <a href="{{ relationUrl }}" title="Visit webpage" rel="noopener" target="_blank"
                           data-icon="world" aria-label="View"></a>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}
