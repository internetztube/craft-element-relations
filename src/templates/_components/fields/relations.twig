{# Expects an Element; Returns an array of Elements. #}
{% set relations = elementRelationsGetRelations(element) %}
{# Expects an Elements; Returns a boolean. #}
{% set seomaticGlobal = elementRelationsIsUsedInSeomaticGlobalSettings(element) %}

{% if not relations and not seomaticGlobal %}
    <span style="color: red">{{ 'field-value-unused' | t('element-relations') }}</span>
{% else %}
    <table class="table">
        <thead>
            <tr>
                <th>Element</th>
                <th>Type</th>
                <th>Site</th>
                <th>Section</th>
                <th>Link</th>
            </tr>
        </thead>
        <tbody>
        {% if seomaticGlobal ?? null %}
            <tr>
                <td colspan="2">{{ 'field-value-seomatic-global' | t('element-relations') }}</td>
                <td></td>
                <td></td>
            </tr>
        {% endif %}
        {% for relation in relations %}
            <tr>
                <td style="white-space: nowrap;">
                    <span style="display: inline-block;">{{ elementRelationsElementPreviewHtml([relation]) | raw }}</span>
                </td>
                <td title="{{ className(relation) }}">
                    {{ relation.displayName }}
                </td>
                <td title="{{ relation.site.handle }}">
                    {{ relation.site.name }}
                </td>
                <td>
                    {% if className(relation) == 'craft\\elements\\Entry' and relation.section %}
                        <span style="color: #666; font-weight: normal; margin-left: 4px;">{{ relation.section.name }}</span>
                    {% endif %}
                </td>
                <td>
                    {% if relation.url %}
                        <a href="{{ relation.url }}" title="Visit webpage" rel="noopener" target="_blank"
                           data-icon="world" aria-label="View"></a>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endif %}
