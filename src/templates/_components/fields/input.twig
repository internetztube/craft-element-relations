<div style="
        border: 1px solid #e3e5e8;
        border-radius: 3px;
        margin-bottom: 10px;
        padding: var(--l);
    ">
    {% if value %}
        {#
        {{ value.count(currentSite.id) }}/{{ value.getElements(currentSite.id, 20) | length }}
        #}
        {% if value.isInUse %}
            {% set currentSiteCount = value.count() %}
            {% if currentSiteCount %}
                <h3>Relations of this site:</h3>
                <div class="element-relations-input" data-endpoint="{{ paginationEndpoint }}"
                     style="overflow: scroll;"></div>
            {% endif %}
            {% set otherSites = value.sites | filter(site => site.id != currentSite.id) %}
            {% if otherSites %}
                {% if currentSiteCount %}
                    <br><br>
                {% endif %}
                <div>
                    <h3>Used in these other sites:</h3>

                    <ul>
                        {% for site in otherSites %}
                            <li>
                                <a href="{{ element.cpEditUrl | replace("?site=" ~ element.site.handle, "?site=" ~ site.handle) }}#{{ tabHash }}"
                                   title="{{ site.handle }}">
                                    {{ site.name }}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            {% if value.isUsedInSeomaticGlobalSettings %}
                {% if otherSites or currentSiteCount %}
                    <hr>
                {% endif %}
                {{ 'field-value-seomatic-global' | t('element-relations') }}
            {% endif %}
        {% else %}
            {% if element.isDraft %}
                Drafts cannot be used in relations
            {% else %}
                <span style="color: #ff0000">{{ 'field-value-unused' | t('element-relations') }}</span>
            {% endif %}
        {% endif %}

    {% else %}
        Element not saved yet
    {% endif %}
</div>
