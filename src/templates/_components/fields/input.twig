<div style="
        margin-bottom: 10px;
    ">

    {% if value %}
        {#
        {{ value.count(currentSite.id) }}/{{ value.getElements(currentSite.id, 20) | length }}
        #}
        {% if value.isInUse %}
            {% set currentSiteCount = value.count() %}
        {% if currentSiteCount %}
            <div data-element-relations-id="{{ containerId }}"
                 class="element-relations-input"
                 style="overflow: scroll;"
            ></div>
            <script>
              (async () => {
                const sleep = ms => new Promise(r => setTimeout(r, ms));
                const endpoint = '{{ paginationEndpoint | raw }}'

                for (let i = 0; i < 10; i++) {
                    const $element = document.querySelector('[data-element-relations-id={{ containerId }}]')
                    if (window.elementRelationsInputInit && $element) {
                      window.elementRelationsInputInit($element, endpoint)
                      break;
                    }
                    await sleep(100)
                }
              })()
            </script>
        {% endif %}
            {% set otherSites = value.sites | filter(site => site.id != currentSite.id) %}
        {% if otherSites %}
        {% if currentSiteCount %}
        <br>
        {% endif %}
            <div>
                <h3>
                    {{ 'field-headline-other-sites' | t('element-relations') }}
                </h3>
                <ul>
                    {% for site in otherSites %}
                        <li>
                            <a href="{{ element.cpEditUrl | replace("?site=" ~ element.site.handle, "?site=" ~ site.handle) }}#{{ tabHash }}"
                               title="{{ site.handle }}">
                                {{ site.name }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        {% if value.isUsedInSeomaticGlobalSettings %}
        {% if otherSites or currentSiteCount %}
        <hr>
        {% endif %}
            {{ 'field-value-seomatic-global' | t('element-relations') }}
        {% endif %}
        {% else %}
        {% if element.isDraft %}
            {{ 'field-hint-draft' | t('element-relations') }}
        {% else %}
            <span style="color: #ff0000">
                    {{ 'field-value-unused' | t('element-relations') }}
                </span>
        {% endif %}
        {% endif %}

    {% else %}
        {{ 'field-hint-not-saved' | t('element-relations') }}
    {% endif %}
</div>
