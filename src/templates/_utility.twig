<h1>{{ "utility-main-headline" | t("element-relations") }}</h1>

<form method="post">
    {{ csrfInput() }}
    <p>{{ "utility-form-rebuild-cache-intro" | t("element-relations") }}</p>
    <button type="submit" class="btn submit">{{ "utility-form-rebuild-cache-button-label" | t("element-relations") }}</button>
</form>

{% if pushed %}
    {% js %}Craft.cp.displayNotice({{ "utility-form-rebuild-cache-success-notice" | t("element-relations") | json_encode | raw }});{% endjs %}
{% endif %}
