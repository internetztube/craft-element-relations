{# the replace wizard in a slideout (ReplaceController::actionWizard()), opened by both replace actions
   (templates/_field/replace.twig): "Replace…" with the usages ticked in the field's list, "Replace everywhere…" with
   all of them. One screen, three steps: the replacement (Craft's element select), where (the ticked usages, each can
   be unticked; all in the list with its filters, when it has more than the ticked page; or everywhere), a review. The slideout's submit button posts it to ReplaceController::actionReplace(),
   which queues the replacement; the notice then follows the job. #}
{% import '_includes/forms' as forms %}
{% set wizardId = random() %}
{% set fromTitle = from.title ?? from|string %}

<div class="element-relations-wizard" data-element-relations-wizard="{{ wizardId }}">
    {{ hiddenInput('fromId', from.id) }}
    {{ hiddenInput('siteId', siteId) }}
    {% if everywhere %}{{ hiddenInput('scope', 'everywhere') }}{% endif %}

    <section class="element-relations-wizard__step">
        <h2><span class="element-relations-wizard__number">1</span>{{ 'wizard-step1'|t('element-relations') }}</h2>
        {{ forms.elementSelectField({
            id: 'replacement',
            name: 'toId',
            instructions: 'wizard-step1-hint'|t('element-relations', {from: fromTitle, type: from.lowerDisplayName()}),
            elementType: className(from),
            limit: 1,
            criteria: {siteId: siteId, id: ['not', from.id]},
            selectionLabel: 'wizard-choose'|t('element-relations'),
        }) }}
    </section>

    <section class="element-relations-wizard__step">
        <h2><span class="element-relations-wizard__number">2</span>{{ 'wizard-step2'|t('element-relations') }}</h2>
        {% if everywhere %}
            <p>{{ 'wizard-everywhere'|t('element-relations', {count: total}) }}</p>
        {% else %}
            {% if listTotal %}
                {# Craft's index ticks within one page; the rest of the (filtered) list is resolved on the server #}
                {{ hiddenInput('criteria', criteria|json_encode) }}
                <div class="element-relations-wizard__scope">
                    <label><input type="radio" name="scope" value="ticked" data-scope{% if not allTicked %} checked{% endif %}> {{ 'wizard-scope-ticked'|t('element-relations', {count: usages|length}) }}</label>
                    <label><input type="radio" name="scope" value="list" data-scope{% if allTicked %} checked{% endif %}> {{ 'wizard-scope-list'|t('element-relations', {count: listTotal}) }}</label>
                </div>
            {% endif %}
            <p class="light" data-ticked>{{ 'wizard-step2-hint'|t('element-relations', {from: fromTitle}) }}</p>
            <div class="element-relations-wizard__usages" data-ticked>
                {% if usages|length > 1 %}
                    <label class="element-relations-wizard__usage element-relations-wizard__usage--all">
                        <input type="checkbox" data-select-all checked>
                        <span>{{ 'wizard-all'|t('element-relations', {count: usages|length}) }}</span>
                    </label>
                {% endif %}
                {% for usage in usages %}
                    <label class="element-relations-wizard__usage">
                        {# its sites and the other sites that change with the edited one feed the review's "What changes" #}
                        <input type="checkbox" name="sourceIds[]" value="{{ usage.id }}" data-usage data-site-ids="{{ usage.siteIds|json_encode }}" data-shared="{{ usage.shared|json_encode }}" data-title="{{ usage.element.title ?? usage.element|string }}" checked>
                        {{ elementChip(usage.element, {hyperlink: false, showStatus: true}) }}
                        <span class="light">{{ [usage.where, usage.field, usage.sites|join(', ')]|filter|join(' · ') }}</span>
                    </label>
                {% endfor %}
            </div>
        {% endif %}
        {% if chooseSites %}
            {# the usages in the site the element is edited in, or in every site; content that is the same in other sites
               changes there too, which the review shows #}
            <div class="element-relations-wizard__scope element-relations-wizard__sites">
                <h3>{{ 'Sites'|t('app') }}</h3>
                <label><input type="radio" name="sites" value="current" data-sites checked> {{ 'wizard-sites-current'|t('element-relations', {site: siteName}) }}</label>
                <label><input type="radio" name="sites" value="all" data-sites> {{ 'wizard-sites-all'|t('element-relations', {sites: sites|join(', ')}) }}</label>
            </div>
        {% endif %}
    </section>

    <section class="element-relations-wizard__step">
        <h2><span class="element-relations-wizard__number">3</span>{{ 'wizard-step3'|t('element-relations') }}</h2>
        <div class="element-relations-wizard__review">
            {{ elementChip(from, {hyperlink: false}) }}
            <span class="element-relations-wizard__arrow" aria-hidden="true">→</span>
            <span data-review-to><span class="light">{{ 'wizard-review-not-chosen'|t('element-relations') }}</span></span>
        </div>
        <p data-summary></p>
        {% if chooseSites %}
            {# per site, how many elements change; then the ones that change in other sites as well, and why #}
            <div class="element-relations-wizard__changes" data-changes>
                <h3>{{ 'wizard-changes'|t('element-relations') }}</h3>
                <dl data-changes-sites></dl>
                <div class="element-relations-wizard__linked" data-linked hidden>
                    <p class="warning with-icon" data-linked-title></p>
                    <p data-linked-why></p>
                    <p class="light" data-linked-names></p>
                </div>
            </div>
        {% endif %}
        {% if revisionHint %}
            <p class="light">{{ revisionHint }}</p>
        {% endif %}
        <p class="light">{{ 'wizard-background'|t('element-relations') }}</p>
    </section>
</div>

{% css %}
.element-relations-wizard [hidden] { display: none !important; }
.element-relations-wizard__step { padding-bottom: var(--l); margin-bottom: var(--l); border-bottom: 1px solid var(--hairline-color); }
.element-relations-wizard__step:last-child { border-bottom: 0; margin-bottom: 0; }
.element-relations-wizard__step h2 { display: flex; align-items: center; gap: var(--s); margin-bottom: var(--s); }
.element-relations-wizard__number {
    display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; border-radius: 50%;
    font-size: 13px; color: var(--white); background: var(--gray-500);
}
.element-relations-wizard__usages { display: flex; flex-direction: column; gap: 2px; margin-top: var(--s); }
.element-relations-wizard__usage { display: flex; align-items: center; gap: var(--s); padding: 6px var(--s); border-radius: var(--small-border-radius); cursor: pointer; }
.element-relations-wizard__usage:hover { background: var(--gray-050); }
.element-relations-wizard__usage--all { font-weight: 600; border-bottom: 1px solid var(--hairline-color); border-radius: 0; margin-bottom: 4px; }
.element-relations-wizard__usage .light { margin-left: auto; text-align: right; }
.element-relations-wizard__scope { display: flex; flex-direction: column; gap: var(--xs); margin-bottom: var(--s); }
.element-relations-wizard__sites { margin-top: var(--l); margin-bottom: 0; }
.element-relations-wizard__sites h3 { margin: 0 0 var(--xs); }
.element-relations-wizard__usage--elsewhere { opacity: .5; }
.element-relations-wizard__changes { margin-bottom: var(--m); }
.element-relations-wizard__changes h3 { margin-bottom: var(--xs); }
.element-relations-wizard__changes dl { display: grid; grid-template-columns: max-content 1fr; gap: 2px var(--m); margin: 0 0 var(--s); }
.element-relations-wizard__changes dt { font-weight: 600; }
.element-relations-wizard__changes dd { margin: 0; font-variant-numeric: tabular-nums; }
.element-relations-wizard__linked { padding: var(--s) var(--m); border-radius: var(--large-border-radius); background: var(--gray-050); }
.element-relations-wizard__linked p { margin: 0 0 var(--xs); }
.element-relations-wizard__linked p:last-child { margin-bottom: 0; }
.element-relations-wizard__review {
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--s); padding: var(--m); margin-bottom: var(--m);
    border-radius: var(--large-border-radius); background: var(--gray-050);
}
.element-relations-wizard__arrow { font-size: 18px; color: var(--light-text-color); }
{% endcss %}

{% js %}
(() => {
    'use strict';
    const $wizard = $('[data-element-relations-wizard="{{ wizardId }}"]');
    const texts = {{ {
        summaryOne: 'wizard-summary-one'|t('element-relations'),
        summaryMany: 'wizard-summary-many'|t('element-relations'),
        summaryIncomplete: 'wizard-summary-incomplete'|t('element-relations'),
        submitOne: 'wizard-submit-one'|t('element-relations'),
        submitMany: 'wizard-submit-many'|t('element-relations'),
        notChosen: 'wizard-review-not-chosen'|t('element-relations'),
        changesOne: 'wizard-changes-one'|t('element-relations'),
        changesMany: 'wizard-changes-many'|t('element-relations'),
        changesNone: 'wizard-changes-none'|t('element-relations'),
        linkedOne: 'wizard-linked-one'|t('element-relations'),
        linkedMany: 'wizard-linked-many'|t('element-relations'),
        linkedWhy: 'wizard-linked-why'|t('element-relations'),
        linkedMore: 'wizard-linked-more'|t('element-relations'),
        from: fromTitle,
        total: total,
        listTotal: listTotal,
        everywhere: everywhere,
        site: from.siteId,
        siteName: siteName,
        siteOrder: siteOrder,
        siteNames: siteNames,
        changesEverywhere: changesEverywhere,
        changesList: changesList,
    }|json_encode|raw }};
    const $usages = $wizard.find('[data-usage]'); // names are namespaced inside the slideout
    const $selectAll = $wizard.find('[data-select-all]');

    /** @returns {JQuery} the chip of the chosen replacement (empty when there is none) */
    const replacementChip = () => $wizard.find('.elementselect .chip, .elementselect .element').first();

    const $scope = $wizard.find('[data-scope]');
    const wholeList = () => $scope.filter(':checked').val() === 'list';
    const onlyHere = () => $wizard.find('[data-sites]:checked').val() === 'current';

    /**
     * Elements that change in other sites as well: their content there is the same as in the edited site.
     * @typedef {Object} LinkedElements
     * @property {number} count
     * @property {number[]} sites ids of those other sites
     * @property {string[]} names the first few (those the user may view)
     */
    /**
     * What a replacement changes, per site id: for "Only in <site>" and for "In all sites".
     * @typedef {Object} Changes
     * @property {Object<string, number>} here
     * @property {Object<string, number>} all
     * @property {LinkedElements} linked
     */
    /** @returns {Changes} the ticked rows' (the whole list and everywhere as the server counted them) */
    const changesNow = () => {
        if (texts.everywhere || wholeList()) {
            return texts.everywhere ? texts.changesEverywhere : texts.changesList;
        }
        const changes = { here: { [texts.site]: 0 }, all: {}, linked: { count: 0, sites: [], names: [] } };
        const add = (counts, site) => { counts[site] = (counts[site] || 0) + 1; };
        $usages.filter(':checked').each((i, el) => {
            const siteIds = $(el).data('siteIds');
            const shared = $(el).data('shared');
            siteIds.forEach((site) => add(changes.all, site));
            if (!siteIds.includes(texts.site)) {
                return;
            }
            add(changes.here, texts.site);
            shared.forEach((site) => add(changes.here, site));
            if (shared.length) {
                changes.linked.count++;
                changes.linked.sites = [...new Set([...changes.linked.sites, ...shared])];
                if (changes.linked.names.length < 5) {
                    changes.linked.names.push(String($(el).data('title')));
                }
            }
        });
        return changes;
    };

    /** The review's "What changes": a line per site, then the elements that change in other sites as well. */
    const showChanges = (changes, here) => {
        const perSite = here ? changes.here : changes.all;
        const name = (site) => texts.siteNames[site];
        $wizard.find('[data-changes-sites]').empty().append(texts.siteOrder.flatMap((site) => {
            const count = perSite[site] || 0;
            return [
                $('<dt/>').text(name(site)),
                $('<dd/>').toggleClass('light', !count).text(count ? (count === 1 ? texts.changesOne : texts.changesMany.replace('{count}', String(count))) : texts.changesNone),
            ];
        }));
        const linked = changes.linked;
        $wizard.find('[data-linked]').prop('hidden', !here || !linked.count);
        const sites = linked.sites.map(name).filter(Boolean).join(', ');
        $wizard.find('[data-linked-title]').text((linked.count === 1 ? texts.linkedOne : texts.linkedMany).replace('{count}', String(linked.count)).replace('{sites}', sites));
        $wizard.find('[data-linked-why]').text(texts.linkedWhy.replaceAll('{site}', texts.siteName));
        const more = linked.count - linked.names.length;
        $wizard.find('[data-linked-names]').text(linked.names.join(' · ') + (more > 0 ? ' ' + texts.linkedMore.replace('{count}', String(more)) : ''));
    };

    const update = () => {
        $wizard.find('[data-ticked]').prop('hidden', wholeList());
        const here = onlyHere();
        $usages.each((i, el) => $(el).closest('.element-relations-wizard__usage').toggleClass('element-relations-wizard__usage--elsewhere', here && !$(el).data('siteIds').includes(texts.site)));
        const changes = changesNow();
        const count = here
            ? (changes.here[texts.site] || 0)
            : (texts.everywhere ? texts.total : (wholeList() ? texts.listTotal : $usages.filter(':checked').length));
        if ($wizard.find('[data-changes]').length) {
            showChanges(changes, here);
        }
        const $chip = replacementChip();
        const replacement = $chip.length ? ($chip.data('label') || $chip.find('.label').text().trim() || $chip.text().trim()) : null;
        const checked = $usages.filter(':checked').length;
        $selectAll.prop('checked', checked === $usages.length).prop('indeterminate', checked > 0 && checked < $usages.length);
        $wizard.find('[data-review-to]').empty().append($chip.length
            // a copy without its id, actions and Craft's fade-in (it starts hidden)
            ? $chip.clone().removeAttr('id style').removeClass('removable').find('.elementselect-remove, .delete, button').remove().end()
            : $('<span class="light"/>').text(texts.notChosen));
        const summary = count === 1 ? texts.summaryOne : texts.summaryMany;
        $wizard.find('[data-summary]').text(replacement && count
            ? summary.replace('{from}', texts.from).replace('{to}', replacement).replace('{count}', String(count))
            : texts.summaryIncomplete);
        const $submit = $wizard.closest('.slideout').find('button[type="submit"]');
        $submit.prop('disabled', !(replacement && count)).toggleClass('disabled', !(replacement && count));
        if (replacement && count) {
            $submit.text((count === 1 ? texts.submitOne : texts.submitMany).replace('{count}', String(count)));
        }
    };

    $selectAll.on('change', function () {
        $usages.prop('checked', this.checked);
        update();
    });
    $usages.on('change', update);
    $scope.on('change', update);
    $wizard.find('[data-sites]').on('change', update);
    // the element select renders its chip asynchronously; follow what it shows
    const $selection = $wizard.find('.elementselect');
    if ($selection.length) {
        new MutationObserver(update).observe($selection[0], { childList: true, subtree: true });
    }
    setTimeout(update, 0);
})();
{% endjs %}
