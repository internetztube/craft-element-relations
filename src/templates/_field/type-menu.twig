{# Type dropdown for the field's index: Craft's menu button markup, placed after the status menu by the script below. #}
{% set total = types|map(t => t.count)|reduce((carry, n) => carry + n, 0) %}
<div class="element-relations-type-menu" data-element-relations-type-menu="{{ id }}">
    <button type="button" class="btn menubtn" aria-label="{{ 'field-column-type'|t('element-relations') }}">{{ 'field-all-types'|t('element-relations') }}</button>
    <div class="menu">
        <ul class="padded">
            <li><a class="sel flex flex-justify" data-type="">{{ 'field-all-types'|t('element-relations') }} <span class="badge">{{ total|number }}</span></a></li>
            {% for class, type in types %}
                <li><a class="flex flex-justify" data-type="{{ class }}">{{ type.label }} <span class="badge">{{ type.count|number }}</span></a></li>
            {% endfor %}
        </ul>
    </div>
</div>
{% js %}
/**
 * Moves the type dropdown next to the index's status menu and filters the index by the chosen element type.
 * @param {JQuery} $menu the `[data-element-relations-type-menu]` wrapper, rendered inside the index's toolbar
 * @returns {void}
 */
window.ElementRelationsTypeMenu = window.ElementRelationsTypeMenu || function ($menu) {
    'use strict';
    const $index = $menu.closest('.element-index');
    const $button = $menu.find('.menubtn');
    let tries = 0;
    const attach = function () {
        /** @type {Craft.BaseElementIndex|undefined} */
        const index = $index.data('elementIndex');
        /** @type {Garnish.MenuBtn|undefined} */
        let menuButton = $button.data('menubtn');
        if ((!index || !menuButton) && tries++ < 40) { return setTimeout(attach, 50); } // index + Craft's menu button init are async
        if (!menuButton) { menuButton = new Garnish.MenuBtn($button); }
        $menu.insertAfter($index.find('.statusmenubtn').parent());
        menuButton.on('optionSelect', function (event) {
            const $option = $(event.option);
            $option.closest('.menu').find('.sel').removeClass('sel');
            $option.addClass('sel');
            $button.text($option.contents().first().text().trim());
            // `data-type` is an element class name, empty for "All types"
            index.settings.criteria.elementTypes = $option.data('type') || null;
            index.setPage(1);
            index.updateElements();
        });
    };
    attach();
};
{% endjs %}
{% js %}
ElementRelationsTypeMenu($('[data-element-relations-type-menu="{{ id }}"]'));
{% endjs %}
