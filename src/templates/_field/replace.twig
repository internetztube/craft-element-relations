{# Pro: "Replace…" wizard in the field's toolbar, built from Craft's element selector modals:
   1. pick the replacement (same element type), 2. pick the usages to replace (the field's own Usage index with
   checkboxes), then the controller runs ReplaceService, the field's index reloads and the notice offers Undo. #}
<div class="element-relations-replace" data-element-relations-replace="{{ id }}">
    <button type="button" class="btn">{{ 'replace-button'|t('element-relations') }}</button>
</div>
{% js %}
/**
 * Settings from ElementRelationsField::$replaceSettings.
 * @typedef {Object} ReplaceSettings
 * @property {string} elementType class of the element being replaced (step 1 lists elements of this type)
 * @property {string} usageType the virtual Usage element type (step 2 lists the usages)
 * @property {number} fromId the element whose usages are replaced
 * @property {number} siteId
 * @property {string} step1Title
 * @property {string} step1Hint
 * @property {string} step1Button
 * @property {string} step2Title contains `{to}`, the replacement's title
 * @property {string} step2Hint contains `{to}`
 * @property {string} step2Button
 * @property {string} undoLabel
 */
/**
 * What the replace endpoint (ReplaceController::actionReplace()) answers with.
 * @typedef {Object} ReplaceResponse
 * @property {string} message
 * @property {number|null} operationId
 * @property {boolean} queued
 */
/**
 * An element picked in one of Craft's selector modals.
 * @typedef {Object} SelectedElement
 * @property {number} id
 * @property {string} label
 */
/*
 * A failed Craft.sendActionRequest() (an axios error). Named typedefs instead of inline object types: two opening
 * braces in a row would start a Twig expression in this template.
 */
/**
 * @typedef {Object} FailedResponseData
 * @property {string} [message]
 */
/**
 * @typedef {Object} FailedResponse
 * @property {FailedResponseData} [data]
 */
/**
 * @typedef {Object} FailedRequest
 * @property {FailedResponse} [response]
 */
/**
 * @param {JQuery} $wrap the `[data-element-relations-replace]` wrapper, rendered inside the index's toolbar
 * @param {ReplaceSettings} settings
 * @returns {void}
 */
window.ElementRelationsReplace = window.ElementRelationsReplace || function ($wrap, settings) {
    'use strict';
    const $index = $wrap.closest('.element-index');
    const refresh = function () {
        const index = $index.data('elementIndex');
        if (index) {
            index.updateElements();
        }
    };
    /** @param {FailedRequest} failure */
    const showError = function (failure) {
        Craft.cp.displayError(failure.response && failure.response.data && failure.response.data.message || Craft.t('app', 'A server error occurred.'));
    };
    /**
     * Craft's selector modal has a title; a one-line hint below it says what the step does.
     * @param {Craft.BaseElementSelectorModal} modal
     * @param {string} hint
     * @returns {Craft.BaseElementSelectorModal}
     */
    const withHint = function (modal, hint) {
        modal.$container.find('.header').append($('<p class="light"/>').text(hint));
        return modal;
    };

    // Placement waits for the index (it renders its toolbar asynchronously); the button works right away.
    let tries = 0;
    const place = function () {
        if (!$index.data('elementIndex') && tries++ < 40) {
            return setTimeout(place, 50);
        }
        let $after = $index.find('[data-element-relations-type-menu]');
        if (!$after.length) {
            $after = $index.find('.statusmenubtn').parent();
        }
        if ($after.length) {
            $wrap.insertAfter($after);
        }
    };
    place();

    /**
     * @param {SelectedElement} replacement the element picked in step 1
     * @param {SelectedElement[]} usages the relating elements picked in step 2
     */
    const replace = function (replacement, usages) {
        Craft.sendActionRequest('POST', 'element-relations/replace/replace', {data: {
            fromId: settings.fromId,
            toId: replacement.id,
            siteId: settings.siteId,
            sourceIds: usages.map(function (usage) { return usage.id; }),
        }}).then(function (response) {
            /** @type {ReplaceResponse} */
            const data = response.data;
            let notice = null;
            let noticeSettings = {};
            if (data.operationId && !data.queued) {
                // Undo right in the notice, which stays until closed; Utilities → Element Relations has the same
                const $undo = $('<button type="button" class="btn small" data-element-relations-undo/>').text(settings.undoLabel).on('click', function () {
                    $undo.addClass('loading').prop('disabled', true);
                    Craft.sendActionRequest('POST', 'element-relations/replace/rollback', {data: {operationId: data.operationId}})
                        .then(function (rollback) { Craft.cp.displaySuccess(rollback.data.message); refresh(); })
                        .catch(showError)
                        .finally(function () { if (notice) { notice.close(); } });
                });
                noticeSettings = {details: $undo, persist: true};
            }
            notice = Craft.cp.displaySuccess(data.message, noticeSettings);
            refresh();
        }).catch(showError);
    };

    $wrap.find('.btn').on('click', function () {
        withHint(Craft.createElementSelectorModal(settings.elementType, {
            multiSelect: false,
            showTitle: true,
            modalTitle: settings.step1Title,
            selectBtnLabel: settings.step1Button,
            disabledElementIds: [settings.fromId],
            /** @param {Array<{id: number, label: string}>} selected exactly one element (multiSelect: false) */
            onSelect: function (selected) {
                const replacement = selected[0];
                withHint(Craft.createElementSelectorModal(settings.usageType, {
                    multiSelect: true,
                    showSiteMenu: false,
                    showTitle: true,
                    modalTitle: settings.step2Title.replace('{to}', replacement.label),
                    selectBtnLabel: settings.step2Button,
                    criteria: {usesElement: settings.fromId, allSites: true},
                    onSelect: function (usages) { replace(replacement, usages); },
                }), settings.step2Hint.replace('{to}', replacement.label));
            },
        }), settings.step1Hint);
    });
};
{% endjs %}
{% js %}
ElementRelationsReplace($('[data-element-relations-replace="{{ id }}"]'), {{ settings|json_encode|raw }});
{% endjs %}
