{# Pro: what both replace actions run (elements/actions/ReplaceUsages: "Replace…" for the usages ticked in the field's
   list; ReplaceRelations: "Replace everywhere…" on an element index). The wizard opens in a slideout
   (ReplaceController::actionWizard()); its submit queues the job, and a notice follows it: the progress while it runs,
   then the result with Undo (also a queue job). The index refreshes when it is done. Registered once per page. #}
{% js %}
/**
 * ReplaceController::actionStatus()
 * @typedef {Object} OperationStatus
 * @property {number} operationId
 * @property {string} status queued, applied, rollbackQueued, rolledBack or failed
 * @property {boolean} done
 * @property {string|null} message
 * @property {boolean} canUndo
 * @property {number|null} progress 0..1 while a large job is underway
 */
/**
 * What to replace.
 * @typedef {Object} ReplaceRequest
 * @property {number} fromId the element to replace
 * @property {number} siteId
 * @property {number[]|null} sourceIds the usages to replace it in (element ids); null: everywhere
 * @property {Object<string, *>} [criteria] the field's index criteria, for the wizard's "All … in the list"
 * @property {boolean} [allTicked] every row of the page was ticked
 */
window.ElementRelationsReplace = window.ElementRelationsReplace || (() => {
    'use strict';
    const t = (message) => Craft.t('element-relations', message);
    /** @param {*} failure a failed Craft.sendActionRequest() */
    const showError = (failure) => {
        const data = failure && failure.response && failure.response.data;
        Craft.cp.displayError(data && data.message || Craft.t('app', 'A server error occurred.'));
    };

    /**
     * Follows a queued replacement or rollback until its job is done, then shows the result.
     * @param {number} operationId
     * @param {string} runningText
     * @param {Craft.BaseElementIndex} index refreshed when it is done
     */
    const follow = (operationId, runningText, index) => {
        const notice = Craft.cp.displayNotice(runningText, { persist: true, icon: 'arrows-rotate' });
        Craft.cp.runQueue?.(); // start the job now instead of on the next poll of Craft's queue runner
        const poll = () => {
            Craft.sendActionRequest('POST', 'element-relations/replace/status', { data: { operationId } })
                .then((response) => {
                    /** @type {OperationStatus} */
                    const status = response.data;
                    if (!status.done) {
                        if (status.progress !== null && notice.$container) {
                            notice.$container.find('.notification-message').text(runningText + ' ' + Math.round(status.progress * 100) + '%');
                        }
                        setTimeout(poll, 1000);
                        return;
                    }
                    notice.close();
                    index.updateElements();
                    if (status.status === 'failed') {
                        Craft.cp.displayError(status.message);
                        return;
                    }
                    showResult(status, index);
                })
                .catch((failure) => {
                    notice.close();
                    showError(failure);
                });
        };
        setTimeout(poll, 600);
    };

    /**
     * The result, with Undo right in the notice (it stays until closed); Utilities → Element Relations has the same.
     * @param {OperationStatus} status
     * @param {Craft.BaseElementIndex} index
     */
    const showResult = (status, index) => {
        if (!status.canUndo) {
            Craft.cp.displaySuccess(status.message);
            return;
        }
        let resultNotice = null;
        const $undo = $('<button type="button" class="btn small" data-element-relations-undo/>').text(t('replace-undo')).on('click', () => {
            $undo.addClass('loading').prop('disabled', true);
            Craft.sendActionRequest('POST', 'element-relations/replace/rollback', { data: { operationId: status.operationId } })
                .then(() => follow(status.operationId, t('rollback-running'), index))
                .catch(showError)
                .finally(() => resultNotice?.close());
        });
        resultNotice = Craft.cp.displaySuccess(status.message, { details: $undo, persist: true });
    };

    return {
        /**
         * Opens the wizard; once it is submitted, follows the queued replacement.
         * @param {ReplaceRequest} request
         * @param {Craft.BaseElementIndex} index
         */
        start(request, index) {
            const params = { fromId: request.fromId, siteId: request.siteId };
            const slideout = new Craft.CpScreenSlideout('element-relations/replace/wizard', {
                params: request.sourceIds
                    ? { ...params, sourceIds: request.sourceIds, criteria: JSON.stringify(request.criteria || {}), allTicked: request.allTicked ? 1 : 0 }
                    : { ...params, scope: 'everywhere' },
            });
            slideout.on('submit', (event) => {
                // the response is in event.response; event.data is only set for screens that save a model
                const data = (event.response && event.response.data) || {};
                if (data.operationId) {
                    follow(data.operationId, t('replace-running'), index);
                }
            });
        },
    };
})();
{% endjs %}
