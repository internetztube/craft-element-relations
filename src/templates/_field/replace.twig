{# Pro: the field's "Replace…" button. It opens the wizard in a slideout (ReplaceController::actionWizard()); the
   replacement runs as a queue job, which this script follows: a notice with a spinner while it runs, then the result
   with Undo (also a queue job), and the field's list refreshes. #}
<div class="element-relations-replace" data-element-relations-replace="{{ id }}">
    <button type="button" class="btn">{{ 'replace-button'|t('element-relations') }}</button>
</div>
{% js %}
/**
 * Settings from ElementRelationsField::$replaceSettings.
 * @typedef {Object} ReplaceSettings
 * @property {number} fromId the element whose usages are replaced
 * @property {number} siteId
 * @property {string} undoLabel
 * @property {string} replaceRunning notice while the replacement job runs
 * @property {string} rollbackRunning notice while the Undo job runs
 */
/**
 * ReplaceController::actionStatus()
 * @typedef {Object} OperationStatus
 * @property {number} operationId
 * @property {string} status queued, applied, rollbackQueued, rolledBack or failed
 * @property {boolean} done
 * @property {string|null} message
 * @property {boolean} canUndo
 * @property {number|null} progress 0..1 while a large job is underway
 */
/**
 * @param {JQuery} $wrap the `[data-element-relations-replace]` wrapper, rendered inside the index's toolbar
 * @param {ReplaceSettings} settings
 */
window.ElementRelationsReplace = window.ElementRelationsReplace || function ($wrap, settings) {
    'use strict';
    const $index = $wrap.closest('.element-index');
    const refresh = function () {
        const index = $index.data('elementIndex');
        if (index) {
            index.updateElements();
        }
    };
    /** @param {*} failure a failed Craft.sendActionRequest() */
    const showError = function (failure) {
        const data = failure && failure.response && failure.response.data;
        Craft.cp.displayError(data && data.message || Craft.t('app', 'A server error occurred.'));
    };

    // Placement waits for the index (it renders its toolbar asynchronously); the button works right away.
    let tries = 0;
    const place = function () {
        if (!$index.data('elementIndex') && tries++ < 40) {
            setTimeout(place, 50);
            return;
        }
        let $after = $index.find('[data-element-relations-type-menu]');
        if (!$after.length) {
            $after = $index.find('.statusmenubtn').parent();
        }
        if ($after.length) {
            $wrap.insertAfter($after);
        }
    };
    place();

    /**
     * Follows a queued replacement or rollback until its job is done, then shows the result.
     * @param {number} operationId
     * @param {string} runningText
     */
    const follow = function (operationId, runningText) {
        const notice = Craft.cp.displayNotice(runningText, { persist: true, icon: 'arrows-rotate' });
        if (Craft.cp.runQueue) {
            Craft.cp.runQueue(); // start the job now instead of on the next poll of Craft's queue runner
        }
        const poll = function () {
            Craft.sendActionRequest('POST', 'element-relations/replace/status', { data: { operationId: operationId } })
                .then(function (response) {
                    /** @type {OperationStatus} */
                    const status = response.data;
                    if (!status.done) {
                        if (status.progress !== null && notice.$container) {
                            notice.$container.find('.notification-message').text(runningText + ' ' + Math.round(status.progress * 100) + '%');
                        }
                        setTimeout(poll, 1000);
                        return;
                    }
                    notice.close();
                    refresh();
                    if (status.status === 'failed') {
                        Craft.cp.displayError(status.message);
                        return;
                    }
                    showResult(status);
                })
                .catch(function (failure) {
                    notice.close();
                    showError(failure);
                });
        };
        setTimeout(poll, 600);
    };

    /** @param {OperationStatus} status */
    const showResult = function (status) {
        if (!status.canUndo) {
            Craft.cp.displaySuccess(status.message);
            return;
        }
        // Undo right in the notice, which stays until closed; Utilities → Element Relations has the same
        let resultNotice = null;
        const $undo = $('<button type="button" class="btn small" data-element-relations-undo/>').text(settings.undoLabel).on('click', function () {
            $undo.addClass('loading').prop('disabled', true);
            Craft.sendActionRequest('POST', 'element-relations/replace/rollback', { data: { operationId: status.operationId } })
                .then(function () {
                    follow(status.operationId, settings.rollbackRunning);
                })
                .catch(showError)
                .finally(function () {
                    if (resultNotice) {
                        resultNotice.close();
                    }
                });
        });
        resultNotice = Craft.cp.displaySuccess(status.message, { details: $undo, persist: true });
    };

    $wrap.find('.btn').on('click', function () {
        const slideout = new Craft.CpScreenSlideout('element-relations/replace/wizard', {
            params: { fromId: settings.fromId, siteId: settings.siteId },
        });
        slideout.on('submit', function (event) {
            // the response is in event.response; event.data is only set for screens that save a model
            const data = (event.response && event.response.data) || {};
            if (data.operationId) {
                follow(data.operationId, settings.replaceRunning);
            }
        });
    });
};
{% endjs %}
{% js %}
ElementRelationsReplace($('[data-element-relations-replace="{{ id }}"]'), {{ settings|json_encode|raw }});
{% endjs %}
