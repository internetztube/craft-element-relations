{% extends '_layout' %}
{% import '_partials/hint' as er %}

{% block content %}
    {% include '_partials/blocks' with {blocks: entry.contentBlocks.all()} %}

    {#
     # Element Relations: rank the destinations by how many stories use them. `count` is one SQL query per destination
     # (no elements are loaded) and, on the front end, counts what visitors may see: live entries, no drafts. Nobody
     # maintains a "stories" field on the destination; the journal entries point to it, the plugin counts backwards.
     #}
    {% set ranked = craft.entries().section('destinations').level(2).all()
        |map(d => {destination: d, stories: d.usedIn.count(sections: ['journal'])})
        |sort((a, b) => b.stories <=> a.stories) %}
    {% set most = (ranked|first).stories ?? 1 %}
    <section class="section er-zone">
        {% set code %}{% verbatim %}
{% set ranked = craft.entries().section('destinations').level(2).all()
    |map(d => {destination: d, stories: d.usedIn.count(sections: ['journal'])})
    |sort((a, b) => b.stories <=> a.stories) %}
        {% endverbatim %}{% endset %}
        {{ er.hint('Ranked by the stories that point to each destination', code, 'Destinations have no “stories” field: the journal entries point to them, `usedIn.count` counts backwards. One SQL query each; on the front end only what visitors may see.') }}
        <div class="section-head"><h2>{{ 'Where we travel most'|t('site') }}</h2><a class="meta" href="{{ url('destinations') }}">{{ 'All destinations'|t('site') }} →</a></div>
        <div class="ranking">
            {% for row in ranked %}
                {% set image = row.destination.heroImage.one() %}
                <a class="rank" href="{{ row.destination.url }}">
                    {% if image %}<img src="{{ image.getUrl({width: 128, height: 128, mode: 'crop'}) }}" alt="">{% else %}<span></span>{% endif %}
                    <span>
                        <strong>{{ row.destination.title }}</strong>
                        <span class="meta">{{ row.destination.summary }}</span>
                        <span class="bar"><span style="width: {{ (row.stories / max(most, 1) * 100)|round }}%"></span></span>
                    </span>
                    <span class="num">{{ row.stories }}<span class="meta" style="font-weight: 500"> {{ 'stories'|t('site') }}</span></span>
                </a>
            {% endfor %}
        </div>
    </section>

    <section class="section">
        <div class="section-head"><h2>{{ 'Latest from the journal'|t('site') }}</h2><a class="meta" href="{{ url('journal') }}">{{ 'Every story'|t('site') }} →</a></div>
        <div class="grid">
            {% for item in craft.entries().section('journal').orderBy('postDate desc').limit(6).all() %}
                {% include '_partials/card' %}
            {% endfor %}
        </div>
    </section>
{% endblock %}
