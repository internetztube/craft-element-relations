{% extends '_layout' %}
{% import '_partials/hint' as er %}

{% block content %}
    <p class="eyebrow">{{ 'Team'|t('site') }}</p>
    <h1>{{ 'Who writes Transit'|t('site') }}</h1>
    <section class="section er-zone">
        {% set code %}{% verbatim %}
{{ person.usedIn.count(sections: ['journal']) }}
        {% endverbatim %}{% endset %}
        {{ er.hint('Stories per writer', code, 'Stories point to their writers; each person counts them backwards.') }}
        <div class="ranking">
            {% for person in craft.entries().section('team').all() %}
                {% set portrait = person.portrait.one() %}
                <a class="rank" href="{{ person.url }}">
                    {% if portrait %}<img src="{{ portrait.getUrl({width: 128, height: 128, mode: 'crop'}) }}" alt="" style="border-radius: 50%">{% else %}<span></span>{% endif %}
                    <span><strong>{{ person.title }}</strong><span class="meta">{{ person.jobTitle }}</span></span>
                    <span class="num">{{ person.usedIn.count(sections: ['journal']) }}<span class="meta" style="font-weight: 500"> {{ 'stories'|t('site') }}</span></span>
                </a>
            {% endfor %}
        </div>
    </section>
{% endblock %}
