{% extends '_layout' %}
{% import '_partials/hint' as er %}

{# /journal: every story, 12 a page; ?destination=<slug> narrows it to one destination (with `usesElement`). #}
{% set destination = craft.app.request.getQueryParam('destination')
    ? craft.entries().section('destinations').slug(craft.app.request.getQueryParam('destination')).one() : null %}
{% set query = craft.entries().section('journal').orderBy('postDate desc').limit(12) %}
{% if destination %}
    {# Element Relations: the same param as on the destination page, combined with an ordinary query #}
    {% do query.usesElement(destination) %}
{% endif %}
{% paginate query as pageInfo, stories %}

{% block content %}
    <p class="eyebrow">{{ 'Journal'|t('site') }}</p>
    <h1>{{ destination ? 'Stories from {place}'|t('site', {place: destination.title}) : 'Every story'|t('site') }}</h1>

    <section class="er-zone" style="margin: 28px 0 40px">
        {% set code %}{% verbatim %}
{% set query = craft.entries().section('journal').limit(12) %}
{% do query.usesElement(destination) %}   {# ?destination=… #}
{% paginate query as pageInfo, stories %}

{{ place.usedIn.count(sections: ['journal']) }}   {# the number per filter #}
        {% endverbatim %}{% endset %}
        {{ er.hint('Filter by destination', code, '`usesElement` narrows an ordinary query to what points to the destination; `usedIn.count` puts the number on each filter.') }}
        <ul class="tags">
            <li><a class="tag {{ destination ? 'neutral' : 'active' }}" href="{{ url('journal') }}">{{ 'All'|t('site') }}</a></li>
            {% for place in craft.entries().section('destinations').level(2).all() %}
                <li><a class="tag {{ destination and destination.id == place.id ? 'active' : 'neutral' }}" href="{{ url('journal', {destination: place.slug}) }}">{{ place.title }} · {{ place.usedIn.count(sections: ['journal']) }}</a></li>
            {% endfor %}
        </ul>
    </section>

    <div class="grid">
        {% for item in stories %}{% include '_partials/card' %}{% endfor %}
    </div>
    {% include '_partials/pager' %}
{% endblock %}
