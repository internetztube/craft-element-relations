{% extends '_layout' %}

{% set hero = entry.heroImage.one() %}

{% block content %}
    <article>
        <p class="eyebrow">{{ entry.type.name }} · {{ entry.postDate|date('j F Y') }}</p>
        <h1>{{ entry.title }}</h1>
        {% if entry.summary ?? null %}<p class="lede">{{ entry.summary }}</p>{% endif %}
        {% set authors = (entry.writtenBy ?? null) ? entry.writtenBy.all() : [] %}
        {% if authors %}
            <p class="meta">{{ 'By'|t('site') }} {% for person in authors %}<a href="{{ person.url }}">{{ person.title }}</a>{{ not loop.last ? ', ' }}{% endfor %}</p>
        {% endif %}

        {% if hero %}
            <figure class="figure">
                <img src="{{ hero.getUrl({width: 1600, height: 800, mode: 'crop'}) }}" alt="{{ hero.alt ?? hero.title }}">
                {#
                 # Element Relations: the photo's own usages, through the field on the asset. This story is one of
                 # them; the rest is "this photo also appears in". `elements` with a limit loads only what is shown.
                 #}
                {% set alsoIn = hero.usedIn.elements(sections: ['journal'], limit: 4)|filter(e => e.id != entry.id) %}
                {% if alsoIn %}
                    <figcaption>
                        {{ 'This photo also appears in'|t('site') }}
                        {% for other in alsoIn %}<a href="{{ other.url }}">{{ other.title }}</a>{{ not loop.last ? ', ' }}{% endfor %}.
                    </figcaption>
                {% endif %}
            </figure>
        {% endif %}

        {% switch entry.type.handle %}
            {% case 'review' %}
                <p class="pill">{{ entry.placeName }} · {{ '★★★★★'|slice(0, entry.rating.value|default(0) + 0) }}</p>
                <div class="prose">{{ entry.body }}</div>
            {% case 'route' %}
                <ol class="prose">
                    {% for stop in entry.stops.all() %}
                        {% set place = stop.destinations.one() %}
                        <li><strong>{% if place %}<a href="{{ place.url }}">{{ stop.title }}</a>{% else %}{{ stop.title }}{% endif %}</strong>{% if stop.travelTime %} · {{ stop.travelTime }}{% endif %}</li>
                    {% endfor %}
                </ol>
            {% case 'photoEssay' %}
                <div class="grid">
                    {% for photo in entry.gallery.all() %}
                        <figure class="figure"><img src="{{ photo.getUrl({width: 800, height: 600, mode: 'crop'}) }}" alt="{{ photo.alt ?? photo.title }}" loading="lazy"></figure>
                    {% endfor %}
                </div>
            {% default %}
                <div class="prose">{{ entry.body }}</div>
        {% endswitch %}

        {% set places = (entry.destinations ?? null) ? entry.destinations.all() : [] %}
        {% if places %}
            <ul class="pills" style="margin-top: 24px">
                {% for place in places %}<li><a class="pill" href="{{ place.url }}">{{ place.title }}</a></li>{% endfor %}
            </ul>
        {% endif %}
    </article>

    {#
     # Element Relations: backlinks. Every element that links to this story: a "Related articles" field elsewhere, a
     # link in another story's text, the homepage's featured articles, a navigation item. Shown only when there are any.
     #}
    {% set relations = entry.usedIn %}
    {% if relations.isInUse %}
        <section class="aside">
            <h2>{{ 'Linked from'|t('site') }}</h2>
            <ul>
                {% for element in relations.elements(limit: 10) %}
                    <li>{% if element.url %}<a href="{{ element.url }}">{{ element.title }}</a>{% else %}{{ element.title ?? element }}{% endif %}
                        <span class="meta">· {{ element.section.name ?? element.displayName() }}</span></li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}
{% endblock %}
